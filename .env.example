# Copy this file to ".env" (same folder) and paste your real Supabase connection string.
# Supabase > your project > Connect (top bar) > "Session pooler" > URI
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres
